// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",        // Logo type: auto, builtin, small, file, etc.
        "source": "windows",      // Built-in logo name or file path
        "width": 24,           // Width in characters
        "height": 12,          // Height in characters
        "padding": {
            "top": 1,          // Top padding
            "left": 2,         // Left padding
            "right": 0         // Right padding
        },
    },
    "display": {
        "separator": ": ",
    },
    "modules": [
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "host",
            "key": "host",
            "format": "{name}"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "cpu",
            "key": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "detectionMethod": "pci",
            "hideType": ["integrated", "unknown"],
            "format": "{name}"
        },
        {
            "type": "disk",
            "key": "📦",
            "format": "{mountpoint} ─ {size-total} ({size-percentage})",
        },
        {
            "type": "memory",
            "key": "ram",
            "format": "{used} / {total}",
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "os",
            "key": "os",
            "format": "{codename}",
        },
        {
            "type": "uptime",
            "key": "uptime",
        }
    ]
}
