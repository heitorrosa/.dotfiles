{
  "$schema": "https://raw.githubusercontent.com/ranxianglei/opencode-acp/master/dcp.schema.json",
  "enabled": true,
  "compress": {
    "maxContextLimit": "50%",
    "minContextLimit": "20%",
    "nudgeFrequency": 6,
    "iterationNudgeThreshold": 15,
    "nudgeForce": "soft"
  },
  "pruneNotification": "off",
  "pruneNotificationType": "toast"
}
