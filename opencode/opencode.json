{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git",
    "opencode-background-agents",
    "opencode-scheduler",
    "context-mode",
    "opencode-acp",
    "~/.config/opencode/plugins/opencode-vcc",
    "~/.config/opencode/plugins/opencode-hermes-memory",
    "~/.config/opencode/plugins/opencode-hermes-skills",
    "~/.config/opencode/plugins/opencode-hermes-vision",
    "~/.config/opencode/plugins/minimize-agent-browser",
    "@prevalentware/opencode-goal-plugin",
    "opencode-autoresearch",
    "opencode-ponytail",
    "opencode-cache-hit"
  ],
  "agent": {
    "general": {
      "permission": {
        "external_directory": "allow"
      },
      "options": {}
    }
  },
  "compaction": {
    "auto": false
  },
  "experimental": {},
  "tools": {
    "webfetch": false,
    "websearch": false
  },
  "mcp": {
    "bladebro": {
      "type": "local",
      "enabled": true,
      "command": ["bladebro", "mcp"],
      "environment": {
        "CHROME_PATH": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\Application\\thorium.exe",
        "BLADE_PROFILE_DIR": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\User Data Agent"
      }
    },
    "hound": {
      "type": "local",
      "enabled": true,
      "command": ["hound"]
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "grep_app": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "composio": {
      "type": "remote",
      "enabled": true,
      "url": "https://connect.composio.dev/mcp"
    },
    "opencode": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "opencode-mcp"]
    },
    "mansa": {
      "type": "remote",
      "enabled": true,
      "url": "http://localhost:3200/stocks/mcp"
    }
  },
  "shell": "powershell"
}