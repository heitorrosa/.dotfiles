{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git",
    "opencode-background-agents",
    "opencode-scheduler",

    "context-mode",
    "opencode-acp",
    "C:/Users/Administrator/.config/opencode/plugins/opencode-vcc",
    "opencode-hermes-memory",
    "C:/Users/Administrator/.config/opencode/plugins/opencode-hermes-skills",
    "C:/Users/Administrator/.config/opencode/plugins/opencode-memory-nudge",
    
    "@prevalentware/opencode-goal-plugin@0.1.17",
    "opencode-ralph-loop",
    "opencode-autoresearch",
    "opencode-ponytail"
  ],
  "agent": {
    "general": {
      "permission": {
        "external_directory": "allow"
      }
    }
  },
  "experimental": {
    "disable_primary_tools": ["compress", "decompress"]
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "enabled": true,
      "command": ["context-mode"],
      "args": ["--ignore", "node_modules,.git,dist,build,package-lock.json,.pnpm-store"]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "websearch": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa"
    },
    "fetch": {
      "type": "local",
      "enabled": true,
      "command": ["python", "-m", "mcp_server_fetch"]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    },
    "grep_app": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "composio": {
      "type": "remote",
      "enabled": true,
      "url": "https://connect.composio.dev/mcp"
    }
  }
}