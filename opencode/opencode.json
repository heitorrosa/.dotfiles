{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "billion-context",
    "@dietrichgebert/ponytail"
  ],
  "agents": {
    "general": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "compaction": {
    "auto": false
  },
  "mcp": {
    "servers": {
      "bladebro": {
        "type": "local",
        "command": ["npx", "-y", "bladebro", "mcp"],
        "environment": {
          "CHROME_PATH": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\Application\\thorium.exe",
          "BLADE_PROFILE_DIR": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\User Data Agent"
        }
      },
      "donsetch": {
        "type": "local",
        "command": ["npx", "-y", "donsetch", "mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp"
      },
      "mansa": {
        "type": "remote",
        "url": "http://localhost:3200/stocks/mcp"
      }
    }
  }
}
