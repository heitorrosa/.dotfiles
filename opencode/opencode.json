{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git",
    "@tarquinen/opencode-dcp",
    "opencode-background-agents",
    "opencode-scheduler",
    "context-mode",
    "opencode-hermes-memory",
    "@prevalentware/opencode-goal-plugin",
    "opencode-ralph-loop",
    "opencode-autoresearch"
  ],
  "agent": {
    "general": {
      "permission": {
        "external_directory": "allow"
      }
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "enabled": true,
      "command": [
        "context-mode"
      ],
      "args": [
        "--ignore",
        "node_modules,.git,dist,build,package-lock.json,.pnpm-store"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "websearch": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa"
    },
    "fetch": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "-m",
        "mcp_server_fetch"
      ]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "grep_app": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    }
  }
}

