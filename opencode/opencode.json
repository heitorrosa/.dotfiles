{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git",
    "opencode-background-agents",
    "opencode-scheduler",
    "context-mode",
    "opencode-acp",
    "~/.config/opencode/plugins/opencode-vcc",
    "~/.config/opencode/plugins/opencode-hermes-memory",
    "~/.config/opencode/plugins/opencode-hermes-skills",
    "@prevalentware/opencode-goal-plugin@0.1.17",
    "opencode-ralph-loop",
    "opencode-autoresearch",
    "opencode-ponytail"
  ],
  "agent": {
    "general": {
      "permission": {
        "external_directory": "allow"
      },
      "options": {}
    }
  },
  "experimental": {},
  "tools": {
    "webfetch": false,
    "websearch": false,
    "compress": false
  },
  "mcp": {
    "chrome": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics", "--userDataDir", "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\User Data Agent", "--executablePath", "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\Application\\thorium.exe", "--chromeArg=--start-minimized"]
    },
    "hound": {
      "type": "local",
      "enabled": true,
      "command": ["hound"]
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "grep_app": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "composio": {
      "type": "remote",
      "enabled": true,
      "url": "https://connect.composio.dev/mcp"
    },
    "mansa": {
      "type": "remote",
      "enabled": true,
      "url": "http://localhost:3200/stocks/mcp"
    }
  },
  "shell": "powershell"
}