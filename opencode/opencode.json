{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "billion-context",
    "@dietrichgebert/ponytail"
  ],
  "default_agent": "asuka",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "agents": {
    "general": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "compaction": {
    "auto": false
  },
  "mcp": {
    "servers": {
      "bladebro": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "bladebro",
          "mcp"
        ],
        "environment": {
          "CHROME_PATH": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\Application\\thorium.exe",
          "BLADE_PROFILE_DIR": "C:\\Users\\Administrator\\AppData\\Local\\Thorium\\User Data Agent"
        }
      },
      "donsetch": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "donsetch",
          "mcp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp"
      },
      "mansa": {
        "type": "remote",
        "url": "http://localhost:8080/stocks/mcp"
      },
      "memo": {
        "type": "remote",
        "url": "http://localhost:5000/mcp",
        "headers": {
          "Authorization": "Bearer pTFiIIPmN0usToWT4UAan5aB7hBJKH47Yyk4AltFR6o"
        }
      },
      "mansa-wallet": {
        "type": "remote",
        "url": "http://localhost:8080/wallet/mcp",
        "oauth": {
          "client_id": "opencode",
          "client_secret": "beb076742a3c4ff38eac6f4fb7acc525",
          "callback_port": 19876,
          "redirect_uri": "http://localhost:19876/callback"
        }
      }
    }
  }
}
